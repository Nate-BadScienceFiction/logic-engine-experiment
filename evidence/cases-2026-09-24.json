      "id": "recursion.an-infinite-answer-set-must-not-be-called-complete",
      "family": "errors-and-completion",
      "termination": "unbounded",
      "topics": [
        "status-channel"
      ],
      "clauses": [
        "nat(z).",
        "nat(s(X)) :- nat(X)."
      ],
      "operations": [
        {
          "id": "q1",
          "op": "query",
          "goal": "nat(X)",
          "variables": [
            "X"
          ]
        }
      ],
      "timeout": 25,
      "oracle": {
        "kind": "adjudicated",
        "ref": "adjudication 2026-09-22: soundness of a completeness claim",
        "note": "nat/1 has infinitely many solutions. Any finite answer set is therefore incomplete, and an engine that returns one while reporting completeness is unsound. Stopping -- a budget, an exhaustion status, a timeout -- is the correct behaviour and passes."
      }
    },
